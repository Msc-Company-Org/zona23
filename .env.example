HOST=127.0.0.1
PORT=3023
DATA_DIR=./local/data
# Para publicar, configurar a origem HTTPS exata e HOST=0.0.0.0 atrás do proxy.
PUBLIC_ORIGIN=
TRUST_PROXY=false
MAX_STORAGE_MB=10240


# Opcional: senha inicial administrativa, no mínimo 12 caracteres. Nunca commitar o valor real.
ADMIN_BOOTSTRAP_PASSWORD=

# Opcional: link de acesso por e-mail (API HTTP no formato Resend). Sem os dois, o link vai pelo WhatsApp.
MAIL_API_KEY=
MAIL_FROM=
# Opcional: impressões digitais SHA-256 do certificado do APK (separadas por vírgula) e pacote Android.
ANDROID_CERT_SHA256=
ANDROID_PACKAGE=br.com.zon023.app
